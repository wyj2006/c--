---
source: src/codegen/riscv/tests/decl.rs
expression: codegen.to_string()
---
e:
.word 1
b:
.zero 4
e2:
.zero 8
main:
    prologue:
        mv fp, sp
        sub sp, sp, 24
    entry:
        sw 1, -8(fp)
        add x32, fp, -4
        mv a0, x32
        add x33, fp, -8
        mv a1, x33
        mv a2, 4
        call memcpy
        li a0, 0
        ret
