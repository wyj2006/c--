---
source: src/codegen/riscv/tests/decl.rs
expression: codegen.to_string()
---
e:
.word 1
b:
.zero 4
e2:
.zero 8
main:
    prologue:
        mv fp, sp
        sub sp, sp, 40
    entry:
        sd ra, -8(fp)
        sd a0, -16(fp)
        sw 1, -24(fp)
        add x32, fp, -20
        mv a0, x32
        add x33, fp, -24
        mv a1, x33
        mv a2, 4
        call memcpy
        li a0, 0
        ld ra, -8(fp)
        ret
