---
source: src/codegen/riscv/tests/decl.rs
expression: codegen.to_string()
---
    .global main
    .section .text
main:
    prologue:
        sd ra, -8(sp)
        sd sp, -16(sp)
        sd fp, -24(sp)
        mv fp, sp
        add sp, sp, -64
    entry:
        li t0, 1
        sw t0, -32(fp)
        li a0, 0
        ld ra, -8(fp)
        ld sp, -16(fp)
        ld fp, -24(fp)
        ret 
    .section .data
e:
    .word 1
b:
    .zero 4
e2:
    .zero 8
