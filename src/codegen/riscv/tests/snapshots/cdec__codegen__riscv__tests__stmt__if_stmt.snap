---
source: src/codegen/riscv/tests/stmt.rs
expression: codegen.to_string()
---
main:
    prologue:
        sd ra, -8(sp)
        sd sp, -16(sp)
        sd fp, -24(sp)
        mv fp, sp
        add sp, sp, -32
    entry:
        lw t0, -32(fp)
        snez t0, t0
        beqz t0, if_else
    if_then:
        lw t0, -32(fp)
        add t0, t0, 1
        sw t0, -32(fp)
        j if_merge
    if_else:
        lw t0, -32(fp)
        add t0, t0, -1
        sw t0, -32(fp)
    if_merge:
        li a0, 0
        ld ra, -8(fp)
        ld sp, -16(fp)
        ld fp, -24(fp)
        ret 
    .global main
