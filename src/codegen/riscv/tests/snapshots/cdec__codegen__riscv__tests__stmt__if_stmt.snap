---
source: src/codegen/riscv/tests/stmt.rs
expression: codegen.to_string()
---
main:
    prologue:
        sd ra, -8(sp)
        sd sp, -16(sp)
        sd fp, -24(sp)
        mv fp, sp
        add sp, sp, -28
    entry:
        lw x32, -28(fp)
        snez x33, x32
        la x34, if_else
        beqz x33, x34
    if_then:
        lw x35, -28(fp)
        add x36, x35, 1
        sw x36, -28(fp)
        j if_merge
    if_else:
        lw x37, -28(fp)
        add x38, x37, -1
        sw x38, -28(fp)
    if_merge:
        li a0, 0
        ld ra, -8(fp)
        ld sp, -16(fp)
        ld fp, -24(fp)
        ret 
    .global main
