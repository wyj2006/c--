---
source: src/codegen/riscv/tests/stmt.rs
expression: codegen.to_string()
---
main:
    prologue:
        mv fp, sp
        sub sp, sp, 20
    entry:
        sd ra, -8(fp)
        sd a0, -16(fp)
        lw x32, -20(fp)
        snez x33, x32
        beqz x33, if_else
    if_then:
        lw x34, -20(fp)
        add x35, x34, 1
        sw x35, -20(fp)
        j if_merge
    if_else:
        lw x36, -20(fp)
        sub x37, x36, 1
        sw x37, -20(fp)
    if_merge:
        li a0, 0
        ld ra, -8(fp)
        ret
