---
source: src/codegen/riscv/tests/stmt.rs
expression: codegen.to_string()
---
main:
    prologue:
        sd ra, -8(sp)
        sd sp, -16(sp)
        sd fp, -24(sp)
        mv fp, sp
        add sp, sp, -64
    entry:
        li t0, 0
        sw t0, -56(fp)
        lw t0, -56(fp)
        sw t0, -48(fp)
    for_cond:
        lw t1, -48(fp)
        lw t0, -40(fp)
        sub t0, t1, t0
        sgtz t0, t0
        seqz t0, t0
        snez t0, t0
        beqz t0, for_exit
        j for_body
    for_body:
        lw t1, -48(fp)
        li t0, 2
        rem t1, t1, t0
        li t0, 0
        sub t0, t1, t0
        seqz t0, t0
        snez t0, t0
        beqz t0, if_else
    if_then:
        j for_exit
        j if_merge
    if_else:
    if_merge:
        lw t1, -48(fp)
        li t0, 3
        rem t1, t1, t0
        li t0, 0
        sub t0, t1, t0
        seqz t0, t0
        snez t0, t0
        beqz t0, if_else2
    if_then2:
        j for_iter
        j if_merge2
    if_else2:
    if_merge2:
        lw t1, -32(fp)
        lw t0, -48(fp)
        lw t0, 0(t0)
        add t0, t1, t0
        sw t0, -32(fp)
        j for_iter
    for_iter:
        lw t0, -48(fp)
        add t0, t0, 1
        sw t0, -48(fp)
        j for_cond
    for_exit:
        li a0, 0
        ld ra, -8(fp)
        ld sp, -16(fp)
        ld fp, -24(fp)
        ret 
    .global main
