main:
    prologue:
        sd ra, -8(sp)
        sd sp, -16(sp)
        sd fp, -24(sp)
        mv fp, sp
        add sp, sp, -64
    entry:
        li t0, 3
        sw t0, -40(fp)
        li t0, 4
        sw t0, -36(fp)
        li t0, 1
        sw t0, -64(fp)
        lw t0, -64(fp)
        sw t0, -56(fp)
        li a0, 0
        ld ra, -8(fp)
        ld sp, -16(fp)
        ld fp, -24(fp)
        ret 
