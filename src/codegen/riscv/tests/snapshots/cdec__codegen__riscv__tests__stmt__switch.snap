---
source: src/codegen/riscv/tests/stmt.rs
expression: codegen.to_string()
---
main:
    prologue:
        sd ra, -8(sp)
        sd sp, -16(sp)
        sd fp, -24(sp)
        mv fp, sp
        add sp, sp, -32
    entry:
        lw t1, -32(fp)
        li t0, 1
        sw t0, -32(fp)
        li t0, 1
        beq t1, t0, case
        li t0, 2
        beq t1, t0, case2
        li t0, 3
        beq t1, t0, case3
        j default
    case:
        li t0, 2
        sw t0, -32(fp)
        j switch_exit
    case2:
        li t0, 3
        sw t0, -32(fp)
    case3:
        li t0, 4
        sw t0, -32(fp)
        j switch_exit
    default:
        li t0, 5
        sw t0, -32(fp)
    switch_exit:
        li a0, 0
        ld ra, -8(fp)
        ld sp, -16(fp)
        ld fp, -24(fp)
        ret 
    .global main
