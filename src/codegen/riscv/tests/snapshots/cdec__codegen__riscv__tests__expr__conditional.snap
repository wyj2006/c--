---
source: src/codegen/riscv/tests/expr.rs
expression: codegen.to_string()
---
main:
    prologue:
        mv fp, sp
        sub sp, sp, 32
    entry:
        sd ra, -8(fp)
        sd a0, -16(fp)
        lw x33, -24(fp)
        snez x34, x33
        beqz x34, cond_false
        j cond_true
    cond_true:
        lw x35, -28(fp)
        mv x32, x35
        j cond_merge
    cond_false:
        lw x36, -32(fp)
        mv x32, x36
        j cond_merge
    cond_merge:
        sw x32, -20(fp)
        li a0, 0
        ld ra, -8(fp)
        ret
