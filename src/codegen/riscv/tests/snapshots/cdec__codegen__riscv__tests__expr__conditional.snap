---
source: src/codegen/riscv/tests/expr.rs
expression: codegen.to_string()
---
main:
    prologue:
        sd ra, -8(sp)
        sd sp, -16(sp)
        sd fp, -24(sp)
        mv fp, sp
        add sp, sp, -64
    entry:
        lw t0, -40(fp)
        snez t0, t0
        beqz t0, cond_false
        j cond_true
    cond_true:
        lw t0, -48(fp)
        mv t0, t0
        j cond_merge
    cond_false:
        lw t0, -56(fp)
        mv t0, t0
        j cond_merge
    cond_merge:
        sw t0, -32(fp)
        li a0, 0
        ld ra, -8(fp)
        ld sp, -16(fp)
        ld fp, -24(fp)
        ret 
    .global main
