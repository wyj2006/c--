---
source: src/codegen/riscv/tests/expr.rs
expression: codegen.to_string()
---
f:
    prologue:
        sd ra, -8(sp)
        sd sp, -16(sp)
        sd fp, -24(sp)
        mv fp, sp
        add sp, sp, -48
    entry:
        sd a0, -32(fp)
        lw t1, -32(fp)
        li t0, 1
        sub t0, t1, t0
        seqz t0, t0
        snez t0, t0
        snez t0, t0
        bnez t0, or_merge
    or_right:
        lw t1, -32(fp)
        li t0, 2
        sub t0, t1, t0
        seqz t0, t0
        snez t0, t0
        snez t0, t0
        j or_merge
    or_merge:
        snez t0, t0
        beqz t0, if_else
    if_then:
        li t0, 1
        mv a0, t0
        ld ra, -8(fp)
        ld sp, -16(fp)
        ld fp, -24(fp)
        ret 
        j if_merge
    if_else:
    if_merge:
        lw t1, -32(fp)
        li t0, 1
        sub t0, t1, t0
        mv a0, t0
        call f
        mv t0, a0
        sd t0, -40(fp)
        lw t1, -32(fp)
        li t0, 2
        sub t0, t1, t0
        mv a0, t0
        call f
        mv t1, a0
        ld t0, -40(fp)
        add t0, t0, t1
        mv a0, t0
        ld ra, -8(fp)
        ld sp, -16(fp)
        ld fp, -24(fp)
        ret 
        li a0, 0
        ld ra, -8(fp)
        ld sp, -16(fp)
        ld fp, -24(fp)
        ret 
main:
    prologue2:
        sd ra, -8(sp)
        sd sp, -16(sp)
        sd fp, -24(sp)
        mv fp, sp
        add sp, sp, -48
    entry2:
        lw t0, -40(fp)
        mv a0, t0
        call f
        mv t0, a0
        sw t0, -32(fp)
        li a0, 0
        ld ra, -8(fp)
        ld sp, -16(fp)
        ld fp, -24(fp)
        ret 
    .global f
    .global main
