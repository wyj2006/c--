---
source: src/codegen/riscv/tests/expr.rs
expression: codegen.to_string()
---
main:
    prologue:
        sd ra, -8(sp)
        sd sp, -16(sp)
        sd fp, -24(sp)
        mv fp, sp
        add sp, sp, -64
    entry:
        lw t1, -32(fp)
        ld t0, -40(fp)
        lw t0, 0(t0)
        add t0, t1, t0
        sw t0, -32(fp)
        ld t1, -40(fp)
        li t0, 4
        sub t0, t1, t0
        sd t0, -40(fp)
        flw ft1, -48(fp)
        flw ft0, -56(fp)
        fmul.s ft0, ft1, ft0
        fsw ft0, -48(fp)
        ld t0, -40(fp)
        snez t0, t0
        snez t0, t0
        beqz t0, and_merge
    and_right:
        flw ft0, -48(fp)
        fcvt.lu.s t0, ft0
        snez t0, t0
        j and_merge
    and_merge:
        snez t0, t0
        bnez t0, or_merge
    or_right:
        flw ft0, -56(fp)
        fcvt.lu.s t0, ft0
        snez t0, t0
        j or_merge
    or_merge:
        sll t0, t0, 56
        srl t0, t0, 56
        sw t0, -32(fp)
        li a0, 0
        ld ra, -8(fp)
        ld sp, -16(fp)
        ld fp, -24(fp)
        ret 
    .global main
