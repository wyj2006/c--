        beqz t0, and_merge
    and_right:
        add t0, fp, -48
        add t0, t0, 0
        flw ft1, 0(t0)
        add t0, fp, -56
        add t0, t0, 0
        flw ft0, 0(t0)
        feq.s t0, ft1, ft0
