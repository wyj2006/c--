        flw ft0, 0(t0)
        feq.s t0, ft1, ft0
        seqz t0, t0
        snez t0, t0
        j or_merge
    or_merge:
        snez t0, t0
        j and_merge
    and_merge:
        fcvt.s.lu ft0, t0
        fsw ft0, 0(t1)
        add t0, fp, -72
        add t1, t0, 4
        li t0, 0
        fmv.s.x ft0, t0
        fsw ft0, 0(t1)
        add t0, fp, -72
